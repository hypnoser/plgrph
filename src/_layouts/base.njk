<!DOCTYPE html>
<html lang="uk">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ title }}</title>
<meta name="description" content="{{ description }}">
<link rel="canonical" href="https://plgrph.com{{ page.url }}">

{# --- Self-hosted fonts, preloaded --- #}
<link rel="preload" href="/assets/fonts/inter-var.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/assets/fonts/manrope-var.woff2" as="font" type="font/woff2" crossorigin>

{# --- Critical CSS inline (буде наповнено на кроці 6+) --- #}
<style>
  @font-face {
    font-family: "Inter";
    src: url("/assets/fonts/inter-var.woff2") format("woff2");
    font-weight: 100 900;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: "Manrope";
    src: url("/assets/fonts/manrope-var.woff2") format("woff2");
    font-weight: 200 800;
    font-style: normal;
    font-display: swap;
  }

  :root {
    --primary: #1877F2;
    --primary-dark: #0C5DC7;
    --accent: #D98E2F;
    --bg: #F7F9FB;
    --text: #1A1D21;
    --text-secondary: #5B6470;
    --border: #E3E7EC;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    font-family: "Inter", -apple-system, sans-serif;
    background: var(--bg);
    color: var(--text);
    line-height: 1.6;
  }

  h1, h2, h3, h4 {
    font-family: "Manrope", -apple-system, sans-serif;
    font-weight: 700;
  }

  a { color: var(--primary); }
</style>

{# --- Schema.org та інші meta будуть додані на кроках 6+ по кожному типу сторінки --- #}
{% block head %}{% endblock %}
</head>
<body>

{% if maintenanceOverlay %}
  {% include "maintenance.njk" %}
{% endif %}

<a href="#main-content" class="skip-link">Перейти до контенту</a>

{% include "header.njk" %}

<main id="main-content">
  {{ content | safe }}
</main>

{% include "footer.njk" %}

</body>
</html>
