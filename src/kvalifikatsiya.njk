---

<section class="qual-hero">
  <div class="qual-hero__inner">
    <span class="qual-hero__eyebrow">Кваліфікація</span>
    <h1>Сертифікати та дипломи</h1>
    <p class="qual-hero__lead">
      Документи, що підтверджують кваліфікацію в поліграфології та клінічній психології.
    </p>
  </div>
</section>

<section class="qual-grid-section">
  <div class="qual-grid-section__inner">

    {% if collections.certificates and collections.certificates.length > 0 %}
      <div class="qual-grid">
        {% for cert in collections.certificates %}
          <button
            type="button"
            class="qual-card"
            data-lightbox-trigger
            data-index="{{ loop.index0 }}"
          >
            <span class="qual-card__image">
              <img src="{{ cert.data.image }}" alt="{{ cert.data.title }}" loading="lazy">
            </span>
            <span class="qual-card__body">
              <span class="qual-card__title">{{ cert.data.title }}</span>
              <span class="qual-card__meta">{{ cert.data.issuer }}{% if cert.data.year %} — {{ cert.data.year }}{% endif %}</span>
            </span>
          </button>
        {% endfor %}
      </div>

      {# --- Лайтбокс: розмітка одна на сторінку, дані підвантажуються JS-масивом нижче --- #}
      <div id="qual-lightbox" class="qual-lightbox" hidden>
        <button type="button" class="qual-lightbox__close" data-lightbox-close aria-label="Закрити">✕</button>
        <button type="button" class="qual-lightbox__nav qual-lightbox__nav--prev" data-lightbox-prev aria-label="Попередній">‹</button>
        <button type="button" class="qual-lightbox__nav qual-lightbox__nav--next" data-lightbox-next aria-label="Наступний">›</button>
        <div class="qual-lightbox__content">
          <img id="qual-lightbox-img" src="" alt="">
          <p id="qual-lightbox-caption" class="qual-lightbox__caption"></p>
        </div>
      </div>

      <script>
        (function () {
          var certs = [
            {% for cert in collections.certificates %}
            {
              src: {{ cert.data.image | dump | safe }},
              title: {{ cert.data.title | dump | safe }},
              issuer: {{ cert.data.issuer | dump | safe }},
              year: {{ cert.data.year | dump | safe }}
            }{% if not loop.last %},{% endif %}
            {% endfor %}
          ];

          var lightbox = document.getElementById("qual-lightbox");
          var imgEl = document.getElementById("qual-lightbox-img");
          var captionEl = document.getElementById("qual-lightbox-caption");
          var currentIndex = 0;

          function renderSlide(index) {
            var c = certs[index];
            if (!c) return;
            imgEl.src = c.src;
            imgEl.alt = c.title;
            captionEl.textContent = c.title + (c.issuer ? " — " + c.issuer : "") + (c.year ? " (" + c.year + ")" : "");
            currentIndex = index;
          }

          function openLightbox(index) {
            renderSlide(index);
            lightbox.hidden = false;
            document.body.style.overflow = "hidden";
          }

          function closeLightbox() {
            lightbox.hidden = true;
            document.body.style.overflow = "";
          }

          document.querySelectorAll("[data-lightbox-trigger]").forEach(function (btn) {
            btn.addEventListener("click", function () {
              openLightbox(parseInt(btn.getAttribute("data-index"), 10));
            });
          });

          lightbox.querySelector("[data-lightbox-close]").addEventListener("click", closeLightbox);
          lightbox.querySelector("[data-lightbox-prev]").addEventListener("click", function () {
            renderSlide((currentIndex - 1 + certs.length) % certs.length);
          });
          lightbox.querySelector("[data-lightbox-next]").addEventListener("click", function () {
            renderSlide((currentIndex + 1) % certs.length);
          });

          lightbox.addEventListener("click", function (e) {
            if (e.target === lightbox) closeLightbox();
          });

          document.addEventListener("keydown", function (e) {
            if (lightbox.hidden) return;
            if (e.key === "Escape") closeLightbox();
            if (e.key === "ArrowLeft") renderSlide((currentIndex - 1 + certs.length) % certs.length);
            if (e.key === "ArrowRight") renderSlide((currentIndex + 1) % certs.length);
          });
        })();
      </script>

    {% else %}
      <div class="qual-empty">
        <svg width="40" height="40" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
          <rect x="8" y="4" width="24" height="32" rx="2" stroke="currentColor" stroke-width="2"/>
          <path d="M14 14H26M14 20H26M14 26H20" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
        <p>Розділ у розробці — сертифікати та дипломи будуть додані найближчим часом.</p>
      </div>
    {% endif %}

  </div>
</section>

