---
layout: base.njk
eleventyComputed:
  extraHead: >-
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Article",
      "headline": {{ title | dump | safe }},
      "description": {{ description | dump | safe }},
      "datePublished": {{ date | isoDate | dump | safe }},
      "image": "https://plgrph.com{{ ogImage | default('/assets/images/og-image.jpg') }}",
      "author": {
        "@type": "Person",
        "name": "Сергій Коржов",
        "url": "https://plgrph.com/pro-specialista/"
      },
      "publisher": {
        "@type": "Organization",
        "name": "PLGRPH",
        "url": "https://plgrph.com/"
      },
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": "https://plgrph.com{{ page.url }}"
      }
    }
    </script>
  breadcrumbSchema: >-
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Головна", "item": "https://plgrph.com/" },
        { "@type": "ListItem", "position": 2, "name": "Блог", "item": "https://plgrph.com/blog/" },
        { "@type": "ListItem", "position": 3, "name": {{ title | dump | safe }}, "item": "https://plgrph.com{{ page.url }}" }
      ]
    }
    </script>
---

<article class="post">
  <div class="post__inner">

    <nav class="post__breadcrumbs" aria-label="Хлібні крихти">
      <a href="/blog/">Блог</a>
      <span aria-hidden="true">→</span>
      <span>{{ title }}</span>
    </nav>

    <header class="post__header">
      <h1>{{ title }}</h1>
      <div class="post__meta">
        <span>{{ date | dateUk }}</span>
        <span aria-hidden="true">·</span>
        <span>Сергій Коржов</span>
      </div>
    </header>

    <div class="post__content">
      {{ content | safe }}
    </div>

    {% set relatedPosts = collections.blogPosts | excludeSelf(page.url) | limit(3) %}
    {% if relatedPosts.length > 0 %}
      <section class="post__related">
        <h2>Читайте також</h2>
        <div class="post__related-grid">
          {% for related in relatedPosts %}
            <a href="{{ related.url }}" class="post__related-card">
              <span class="post__related-date">{{ related.date | dateUk }}</span>
              <h3>{{ related.data.title }}</h3>
            </a>
          {% endfor %}
        </div>
      </section>
    {% endif %}

    <footer class="post__footer">
      <a href="/blog/" class="btn btn--ghost">← Усі статті</a>
    </footer>

  </div>
</article>

<style>
  .post {
    padding: 48px 24px 64px;
    background: #fff;
  }

  .post__inner {
    max-width: 720px;
    margin: 0 auto;
  }

  .post__breadcrumbs {
    font-size: 13px;
    color: var(--text-secondary);
    margin-bottom: 24px;
  }

  .post__breadcrumbs a {
    color: var(--text-secondary);
    text-decoration: none;
  }

  .post__breadcrumbs a:hover {
    color: var(--primary);
  }

  .post__breadcrumbs span[aria-hidden] {
    margin: 0 6px;
  }

  .post__header {
    margin-bottom: 32px;
  }

  .post__header h1 {
    font-size: 30px;
    line-height: 1.3;
    margin-bottom: 12px;
  }

  .post__meta {
    font-size: 14px;
    color: var(--text-secondary);
  }

  .post__meta span[aria-hidden] {
    margin: 0 8px;
  }

  .post__content {
    font-size: 16px;
    line-height: 1.7;
    color: var(--text);
  }

.post__content img {
  display: block;
  width: 100%;
  max-width: 100%;
  height: auto;
  margin: 28px auto;
  border-radius: 10px;
}

  .post__content p {
    margin-bottom: 20px;
  }

  .post__content h2 {
    font-size: 22px;
    margin: 36px 0 16px;
  }

  .post__content h3 {
    font-size: 18px;
    margin: 28px 0 12px;
  }

  .post__content ul,
  .post__content ol {
    margin: 0 0 20px 24px;
  }

  .post__content li {
    margin-bottom: 8px;
  }

  .post__content a {
    color: var(--primary);
  }

  .post__content blockquote {
    border-left: 3px solid var(--primary);
    padding-left: 16px;
    margin: 24px 0;
    color: var(--text-secondary);
    font-style: italic;
  }

  .post__related {
    margin-top: 48px;
    padding-top: 32px;
    border-top: 1px solid var(--border);
  }

  .post__related h2 {
    font-size: 20px;
    margin-bottom: 20px;
  }

  .post__related-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  .post__related-card {
    display: block;
    background: var(--bg);
    border: 1px solid var(--border);
    border-left: 3px solid var(--accent);
    border-radius: 10px;
    padding: 16px;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.15s ease;
  }

  .post__related-card:hover {
    border-color: var(--primary);
  }

  .post__related-date {
    font-size: 12px;
    color: var(--text-secondary);
  }

  .post__related-card h3 {
    font-size: 14px;
    color: var(--text);
    margin-top: 6px;
  }

  .post__footer {
    margin-top: 48px;
    padding-top: 24px;
    border-top: 1px solid var(--border);
  }

  @media (max-width: 600px) {
    .post__header h1 { font-size: 24px; }
    .post__related-grid { grid-template-columns: 1fr; }
  }
</style>
