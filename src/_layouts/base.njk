<!DOCTYPE html>
<html lang="uk">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ title }}</title>
<meta name="description" content="{{ description }}">
<link rel="canonical" href="https://plgrph.com{{ page.url }}">

{# --- Self-hosted fonts, preloaded --- #}
<link rel="preload" href="/assets/fonts/inter-var.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/assets/fonts/manrope-cyrillic-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/assets/fonts/manrope-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>

{# --- Critical CSS inline (буде наповнено на кроці 6+) --- #}
<style>
  @font-face {
    font-family: "Inter";
    src: url("/assets/fonts/inter-var.woff2") format("woff2");
    font-weight: 100 900;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: "Manrope";
    src: url("/assets/fonts/manrope-latin-wght-normal.woff2") format("woff2");
    font-weight: 200 800;
    font-style: normal;
    font-display: swap;
    unicode-range: U+000D, U+0020-007E, U+00A0-00FF, U+0102, U+0131, U+0152-0153, U+02C6, U+02DA, U+02DC, U+2013-2014, U+2018-201A, U+201C-201E, U+2022, U+2026, U+2039-203A, U+2044, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215;
  }
  @font-face {
    font-family: "Manrope";
    src: url("/assets/fonts/manrope-latin-ext-wght-normal.woff2") format("woff2");
    font-weight: 200 800;
    font-style: normal;
    font-display: swap;
    unicode-range: U+000D, U+0020, U+0041, U+00A0, U+00C1, U+0100-0113, U+0116-012B, U+012E-0130, U+0134-0137, U+0139-013E, U+0141-0148, U+014A-014D, U+0150-0151, U+0154-017E, U+0192, U+01A0-01A1, U+01AF-01B0, U+0218-021B, U+0259, U+02C7, U+02DD, U+1E80-1E85, U+1E9E, U+1EF2-1EF9, U+2020, U+20A3, U+20A9-20AB, U+20AE, U+20B1, U+20B4, U+20B9-20BA, U+20BD, U+20BF;
  }
  @font-face {
    font-family: "Manrope";
    src: url("/assets/fonts/manrope-cyrillic-wght-normal.woff2") format("woff2");
    font-weight: 200 800;
    font-style: normal;
    font-display: swap;
    unicode-range: U+000D, U+0020, U+0041, U+00A0, U+00C1, U+0102, U+0400-045F, U+0490-0491, U+2116;
  }
  @font-face {
    font-family: "Manrope";
    src: url("/assets/fonts/manrope-cyrillic-ext-wght-normal.woff2") format("woff2");
    font-weight: 200 800;
    font-style: normal;
    font-display: swap;
    unicode-range: U+000D, U+0020, U+0041, U+00A0, U+00C1, U+0102, U+04AE-04AF, U+04BA-04BB, U+04E8-04E9, U+20B4;
  }

  :root {
    --primary: #1877F2;
    --primary-dark: #0C5DC7;
    --accent: #D98E2F;
    --bg: #F7F9FB;
    --text: #1A1D21;
    --text-secondary: #5B6470;
    --border: #E3E7EC;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    font-family: "Inter", -apple-system, sans-serif;
    background: var(--bg);
    color: var(--text);
    line-height: 1.6;
  }

  h1, h2, h3, h4 {
    font-family: "Manrope", -apple-system, sans-serif;
    font-weight: 700;
  }

  a { color: var(--primary); }

  .skip-link {
    position: absolute;
    top: -100px;
    left: 16px;
    background: var(--primary);
    color: #fff;
    padding: 10px 18px;
    border-radius: 6px;
    text-decoration: none;
    font-weight: 700;
    z-index: 10001;
    transition: top 0.15s ease;
  }

  .skip-link:focus {
    top: 16px;
  }
</style>

{# Схема.org та інші meta будуть додані на кроках 6+ по кожному типу сторінки #}
{{ extraHead | safe if extraHead }}
</head>
<body>

{% if maintenanceOverlay %}
  {% include "maintenance.njk" %}
{% endif %}

<a href="#main-content" class="skip-link">Перейти до контенту</a>

{% include "header.njk" %}

<main id="main-content">
  {{ content | safe }}
</main>

{% include "footer.njk" %}

</body>
</html>
